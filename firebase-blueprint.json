{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "A rental vehicle or scooty in Noor Rentals fleet",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique vehicle ID" },
        "name": { "type": "string", "description": "Vehicle model name" },
        "category": { "type": "string", "description": "Category (bikes, scooties, vans, cars)" },
        "plateNumber": { "type": "string", "description": "Sri Lankan license plate number" },
        "dailyRate": { "type": "number", "description": "Daily rental rate in LKR" },
        "status": { "type": "string", "description": "Current availability status" },
        "image": { "type": "string", "description": "Vehicle photo URL or base64 data" },
        "odometer": { "type": "number", "description": "Current odometer in km" },
        "fuelLevel": { "type": "number", "description": "Fuel level 0.0 to 1.0" },
        "engineCC": { "type": "string", "description": "Engine displacement" },
        "transmission": { "type": "string", "description": "Transmission type" },
        "year": { "type": "number", "description": "Model year" },
        "revenueGenerated": { "type": "number", "description": "Total revenue generated" },
        "totalTrips": { "type": "number", "description": "Completed trips count" },
        "insuranceExpiry": { "type": "string", "description": "Insurance expiry date" },
        "revenueLicenseExpiry": { "type": "string", "description": "Revenue licence expiry date" },
        "lastServiceKm": { "type": "number", "description": "Last service km" },
        "nextServiceKm": { "type": "number", "description": "Next scheduled service km" },
        "notes": { "type": "string", "description": "Vehicle notes" }
      },
      "required": ["id", "name", "plateNumber", "dailyRate", "status"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A customer rental or tour booking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Booking reference code" },
        "customer": { "type": "object", "description": "Customer personal details" },
        "vehicleId": { "type": "string", "description": "Rented vehicle ID" },
        "vehicleName": { "type": "string", "description": "Vehicle model name" },
        "vehicleCategory": { "type": "string", "description": "Category" },
        "vehiclePlate": { "type": "string", "description": "License plate" },
        "pickupDate": { "type": "string", "description": "Pickup date" },
        "pickupTime": { "type": "string", "description": "Pickup time" },
        "returnDate": { "type": "string", "description": "Expected return date" },
        "returnTime": { "type": "string", "description": "Expected return time" },
        "days": { "type": "number", "description": "Rental duration in days" },
        "ratePerDay": { "type": "number", "description": "Daily rate in LKR" },
        "totalRentalFee": { "type": "number", "description": "Total fee in LKR" },
        "advanceAmount": { "type": "number", "description": "Advance paid in LKR" },
        "balanceDue": { "type": "number", "description": "Remaining balance in LKR" },
        "securityDeposit": { "type": "number", "description": "Deposit held" },
        "depositHeldType": { "type": "string", "description": "Deposit type" },
        "paymentMethod": { "type": "string", "description": "Payment method" },
        "paymentStatus": { "type": "string", "description": "Payment status" },
        "status": { "type": "string", "description": "Rental lifecycle status" },
        "dayFolder": { "type": "string", "description": "Assigned day folder" }
      },
      "required": ["id", "vehicleId", "pickupDate", "returnDate", "totalRentalFee", "status"]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Noor Rentals business configuration and contact profile",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "description": "Business trade name" },
        "ownerName": { "type": "string", "description": "Owner name" },
        "phone": { "type": "string", "description": "Contact phone / WhatsApp" },
        "email": { "type": "string", "description": "Email address" },
        "address": { "type": "string", "description": "Physical shop address" },
        "city": { "type": "string", "description": "City" },
        "currency": { "type": "string", "description": "Currency code" },
        "currencySymbol": { "type": "string", "description": "Currency symbol" },
        "termsAndConditions": { "type": "string", "description": "Standard rental agreement terms" },
        "logoUrl": { "type": "string", "description": "Custom logo URL or data" }
      }
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Collection of all rental vehicles and scooties"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Collection of customer rental agreements and bookings"
    },
    "/businessProfile/{profileId}": {
      "schema": { "$ref": "#/entities/BusinessProfile" },
      "description": "Shop settings and business configuration"
    }
  }
}
